# Copy to .env and fill in. Without any key GridMind runs its deterministic agents (fully reproducible).

# --- Gemini (default provider when a Gemini key is present) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# minimal | low | medium | high
GEMINI_THINKING_LEVEL=low

# --- Claude (optional alternative provider) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# auto (Gemini if its key is set, else Claude, else offline) | gemini | anthropic
GRIDMIND_PROVIDER=auto
# auto (call the API when a key is set) | off (deterministic only) | replay (cached responses only)
GRIDMIND_LLM=auto
